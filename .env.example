# CrowdPlan environment template. Copy to .env.local for development.
# Never commit real values. NEXT_PUBLIC_* values are sent to the browser.

# --- Supabase (public, browser-safe) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- Server-only database role (least-privilege login role created by migrations) ---
# Transaction-pooler connection string for the `crowdplan_server` role.
CROWDPLAN_SERVER_DATABASE_URL=postgres://crowdplan_server.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# --- Public app origin (used for invite links and auth redirects) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Invite link encryption (server only): 32 random bytes, base64
CROWDPLAN_INVITE_KEY=

# --- Scheduled jobs: shared secret sent by pg_cron/pg_net to /api/jobs/run ---
CROWDPLAN_JOB_SECRET=

# --- External data (server only). Required for live search; without it only
#     manual/user-entered candidates and clearly labeled demo data are available.
SERPAPI_API_KEY=
# Optional: default per-plan external search budget and cache TTL overrides
CROWDPLAN_PLAN_SEARCH_BUDGET=12

# --- Natural-language interpretation (server only, optional).
#     Without a key the deterministic parser is used.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Email notifications (server only, optional). In-app notifications always work.
RESEND_API_KEY=
RESEND_FROM=CrowdPlan <notifications@example.com>

# --- Optional Google OAuth button (enable only after configuring the provider in Supabase)
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# --- Optional error monitoring
SENTRY_DSN=

# --- Test automation only (never set in the browser). Used by Playwright/integration
#     tests to create tagged test accounts through the guarded cp-admin edge function.
E2E_ADMIN_SECRET=
E2E_BASE_URL=http://localhost:3000
